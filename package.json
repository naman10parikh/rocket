{
  "name": "rocket",
  "version": "0.1.0",
  "private": true,
  "description": "rocket — the Energy fleet's release-engineering employee (deploy + CI/CD). Private fleet repo; not published.",
  "type": "module",
  "scripts": {
    "dsip:check": "node tools/dsip-check.mjs dsip.json",
    "dsip:test": "node tools/dsip-check.test.mjs",
    "eval": "node eval/run.mjs",
    "eval:nightly": "node eval/run.mjs --nightly",
    "eval:all": "node eval/run.mjs --all",
    "eval:build": "node tools/rocket/node_modules/typescript/bin/tsc -p eval/tsconfig.json",
    "test:cockpit": "node --test web/test/cockpit-api.test.mjs",
    "test:cockpit:e2e": "node web/test/cockpit-e2e.mjs"
  }
}
